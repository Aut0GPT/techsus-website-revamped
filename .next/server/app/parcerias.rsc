5:[["$","$L8",null,{"locale":"pt","dict":{"meta":{"title":"TECHSUS - Construção Industrializada Sustentável","description":"Sistema construtivo industrializado que revoluciona a construção civil com sustentabilidade, eficiência e qualidade industrial. Painéis de concreto autoportantes com tecnologia patenteada."},"navigation":{"home":"Início","about":"Quem Somos","products":"Produtos","system":"Sistema","process":"Processo","strategy":"Estratégia","partnerships":"Parcerias","market":"Mercado","investors":"Investidores","live_cameras":"Câmeras ao Vivo","contact":"Contato"},"hero":{"title":"Construção Industrializada com Tecnologia Sustentável","subtitle":"Inovação e eficiência para a construção civil moderna, do projeto à entrega.","cta":"Entre em Contato"},"introduction":{"title":"Bem-vindo à TECHSUS","subtitle":"Industrializamos paredes e lajes em concreto para executar grandes volumes de edificações em tempo reduzido, com desperdício zero e mão de obra qualificada.","speed_title":"Velocidade","speed_description":"Redução de até 40% no tempo total da obra.","sustainability_title":"Sustentabilidade","sustainability_description":"Economia de recursos naturais e zero desperdício.","quality_title":"Qualidade Superior","quality_description":"Controle industrial que elimina patologias e manutenções."},"process":{"title":"Nosso Processo em Ação","subtitle":"Da fábrica ao canteiro de obras, nosso método garante eficiência e precisão.","planning_title":"1. Planejamento","planning_description":"Compatibilização e desenvolvimento de projetos industriais detalhados.","manufacturing_title":"2. Fabricação","manufacturing_description":"Produção industrial em ambiente controlado com alta precisão.","logistics_title":"3. Logística","logistics_description":"Transporte seguro e otimizado para o canteiro de obras.","assembly_title":"4. Montagem","assembly_description":"Estrutura erguida com rapidez e precisão no local.","main_title":"Do Projeto à Realidade: Eficiência em 4 Etapas","main_description":"O sistema TECHSUS revoluciona a construção civil através de um processo otimizado que garante velocidade, qualidade e sustentabilidade.","step1_title":"1. Compatibilização e o desenvolvimento de projetos industriais","step1_description":"Tudo começa com um planejamento detalhado. Nossa equipe de engenharia utiliza softwares avançados para modelar o projeto, otimizar o layout dos painéis e planejar cada etapa da produção e montagem, garantindo precisão e eficiência.","step2_title":"2. Fabricação Industrial (Off-site)","step2_description":"O processo continua em nossa fábrica, onde os painéis de concreto são produzidos em um ambiente controlado. Utilizando moldes de alta precisão e maquinário automatizado, garantimos a perfeição dimensional, a qualidade do concreto e a integração de todos os componentes, como dutos e vãos.","step3_title":"3. Logística e Transporte","step3_description":"Após a cura e um rigoroso controle de qualidade, os painéis são cuidadosamente carregados em veículos especiais. A logística é planejada para otimizar o tempo de transporte e garantir que os painéis cheguem ao canteiro de obras em perfeitas condições e na ordem correta para a montagem.","step4_title":"4. Montagem Rápida (On-site)","step4_description":"No canteiro de obras, a magia acontece. Com o auxílio de um guindaste, os painéis são rapidamente içados e posicionados. Nossa equipe especializada realiza a montagem, conectando os painéis para formar a estrutura da edificação em uma fração do tempo de uma construção convencional.","advantages_title":"Vantagens do Nosso Processo","advantage1_title":"Velocidade","advantage1_description":"Redução de até 40% no tempo total da obra.","advantage2_title":"Qualidade Controlada","advantage2_description":"Produção industrial garante padrão e precisão.","advantage3_title":"Sustentabilidade","advantage3_description":"Zero desperdício de materiais no canteiro."},"case_studies":{"title":"Cases de Sucesso e Resultados Comprovados","subtitle":"Nossos projetos demonstram consistentemente uma redução de 40% no tempo de construção, zero desperdício de materiais e qualidade superior comprovada.","metrics":{"time_reduction":"Redução de Tempo","waste":"Desperdício de Material","quality_control":"Controle de Qualidade","projects":"Projetos Entregues"},"prototype_title":"Casa Protótipo - São Simão/SP","prototype_description":"Projeto-piloto entregue em Fevereiro de 2025 demonstrando nossa capacidade de execução com qualidade superior e prazos acelerados.","prototype_area":"Área Construída","prototype_time":"Tempo Total","prototype_testimonial":"A casa ficou exatamente como planejamos, com acabamento perfeito e foi entregue muito mais rápido do que esperávamos.","building_title":"Edifício T+3 - Rio Claro/SP","building_description":"Primeiro projeto vertical demonstrando a aplicação da tecnologia em construções de múltiplos pavimentos com eficiência estrutural.","building_area":"Área Total","building_units":"Unidades","building_result":"Resultado: Estrutura completa montada em 45% menos tempo que construção tradicional.","varzea_title":"Casa - Várzea Paulista/SP","varzea_description":"Residência unifamiliar demonstrando versatilidade arquitetônica do sistema.","duque_title":"Edifício T+3 - Duque de Caxias/RJ","duque_description":"Expansão regional demonstrando escalabilidade do sistema construtivo.","premium_finish":"Acabamento Premium","deadline_met":"Prazo Cumprido","optimized_logistics":"Logística Otimizada","certified_quality":"Qualidade Certificada"},"technology":{"title":"Tecnologia Patenteada e Comprovada","description":"Nosso sistema construtivo possui proteção intelectual no Brasil, EUA e China, além de ser validado por rigorosos testes em laboratórios credenciados como o IPT.","certification_text":"As certificações técnicas atestam a conformidade normativa e a qualidade superior do nosso processo industrializado, garantindo segurança e durabilidade."},"cta":{"title":"Transforme sua Construção com a TECHSUS","subtitle":"Entre em contato e descubra como nossa tecnologia pode acelerar seus projetos com mais qualidade e sustentabilidade.","button":"Solicitar uma Proposta"},"modal":{"close":"Fechar modal"},"footer":{"company_description":"Construção industrializada com tecnologia sustentável e altamente escalável.","quick_links":"Links Rápidos","company":"Empresa","system":"Sistema","contact":"Contato","follow_us":"Siga-nos","copyright":"Todos os direitos reservados."},"contact":{"title":"Contato","subtitle":"Fale Conosco","description":"Estamos à disposição para esclarecer dúvidas, agendar reuniões e apresentar nossas soluções inovadoras para a construção civil.","our_contacts":"Nossos Contatos","contact_person":"Contato","location":"Localização","location_text":"São Paulo - SP, Brasil","send_message":"Envie uma Mensagem","name":"Nome","email":"E-mail","message":"Mensagem","send_button":"Enviar Mensagem"},"about":{"title":"Quem Somos","company_title":"A TECHSUS","company_description_1":"A TECHSUS é um grupo de empresas voltadas à gestão e implantação de um sistema inovador para a construção industrializada de painéis estruturais bioclimáticos de concreto com patentes requeridas e concedidas no Brasil, China e EUA.","company_description_2":"Posicionada na vanguarda da Revolução Industrial 4.0 com automação e modelagem de informação, esse modelo evolui em consonância com as agendas ODS - Objetivos de Desenvolvimento Sustentável.","sustainability_title":"Compromisso com a Sustentabilidade","sustainability_description":"Posicionada na vanguarda da Revolução Industrial 4.0 com automação e modelagem de informação, esse modelo evolui em consonância com as agendas ODS - Objetivos de Desenvolvimento Sustentável.","ods_9":"Indústria, inovação e infraestrutura","ods_11":"Cidades e comunidades sustentáveis","ods_12":"Consumo e produção responsáveis","ods_13":"Ação contra mudança global do clima","esg_title":"Agenda ESG","esg_description":"Além dos benefícios econômicos e de escala, o método construtivo atende a agenda ESG, já que há substancial economia de recursos naturais e consequente diminuição de atividades poluentes.","trajectory_title":"Trajetória e Validação","trajectory_description":"Nossa tecnologia é fruto de anos de desenvolvimento e possui validação dos mais respeitados órgãos técnicos.","patents_title":"Patentes e Propriedade Intelectual","patents_description":"O sistema TECHSUS é protegido por patentes no Brasil e nos Estados Unidos, garantindo nossa posição de vanguarda no mercado.","patent_brazil":"Patente Brasil","patent_usa":"Patente Estados Unidos","patent_china":"Patente China","patent_brazil_org":"Instituto Nacional da Propriedade Industrial (INPI)","patent_usa_org":"United States Patent and Trademark Office (USPTO)","patent_china_org":"Escritório Estatal de Propriedade Intelectual da China (SIPO)","ipt_title":"Relatórios Técnicos IPT","ipt_description":"Validação completa do Instituto de Pesquisas Tecnológicas com ensaios de desempenho, térmica, acústica e durabilidade.","ipt_performance":"Desempenho do Sistema","ipt_thermal":"Conforto Térmico","ipt_acoustic":"Desempenho Acústico","ipt_durability":"Durabilidade","certifications_title":"Certificações e Homologações Oficiais","certifications_description":"Homologações dos principais órgãos técnicos e governamentais, garantindo conformidade com as normas brasileiras.","datec_title":"Certificado DATEC","datec_description":"Documento de Avaliação Técnica","caixa_title":"Caixa Econômica Federal","caixa_description":"Homologação Oficial","cdhu_title":"CDHU","cdhu_description":"Companhia de Desenvolvimento Habitacional","sinat_title":"SINAT","sinat_description":"Sistema Nacional de Aprovações Técnicas"},"system":{"title":"Sistema Construtivo","main_title":"Tecnologia e Inovação no DNA","main_description":"Nosso sistema é baseado em painéis de concreto autoportantes, produzidos industrialmente para garantir máxima qualidade, precisão e desempenho.","panel_title":"O Painel TECHSUS","panel_description":"O coração do nosso sistema é o painel nervurado de concreto armado. Ele é composto por duas placas de concreto conectadas por nervuras treliçadas, criando um núcleo oco que pode ser preenchido com material isolante ou concreto, conforme a necessidade do projeto.","panel_feature_1":"Leveza e resistência estrutural.","panel_feature_2":"Excelente desempenho térmico e acústico.","panel_feature_3":"Instalações elétricas e hidráulicas já embutidas.","connections_title":"Conexões Inteligentes","connections_description":"A inovação do sistema reside na forma como os painéis se conectam, criando uma estrutura monolítica robusta e de alta performance através do grauteamento das juntas.","connections_detail_1":"Tipos de nervuras e ligações entre painéis.","connections_detail_2":"Seção transversal da conexão entre painel e laje.","production_title":"Do Controle da Fábrica à Agilidade na Montagem","production_description":"Unimos o melhor dos dois mundos: a precisão da indústria e a rapidez da montagem no local.","offsite_title":"Produção Off-site","offsite_description":"Qualidade e precisão garantidas em ambiente industrial.","onsite_title":"Montagem On-site","onsite_description":"Estrutura montada em tempo recorde com mínimo de mão de obra."},"products":{"title":"Produtos e Soluções","main_title":"Nossos Projetos","main_description":"O sistema TECHSUS é aplicável a uma vasta gama de projetos, desde casas unifamiliares a grandes complexos residenciais e comerciais.","category1_title":"Residencial Unifamiliar","category1_subtitle":"Casas Térreas e Sobrados","category1_description":"Modelos de residências que demonstram a versatilidade e a qualidade de acabamento do sistema TECHSUS para moradias unifamiliares.","category2_title":"Edifícios Multifamiliares","category2_subtitle":"Prédios Habitacionais","category2_description":"Edifícios residenciais de múltiplos andares construídos com o sistema, provando sua eficácia em projetos verticais de grande escala.","category3_title":"Etapas de Montagem","category3_subtitle":"Do alicerce até paredes estruturais de vedação","category3_description":"Visão geral das etapas de construção, desde a fundação até a montagem final dos painéis no canteiro de obras.","video_not_supported":"Seu navegador não suporta o elemento de vídeo.","project_3d_label":"Projeto 3D"},"strategy":{"title":"Nossa Estratégia","future_vision_title":"Visão de Futuro","future_vision_description":"Nossa estratégia é liderar a transformação global da construção civil, iniciando no Brasil e expandindo para mercados internacionais, tornando a construção mais eficiente, sustentável e alinhada às demandas do século 21.","expansion_title":"Expansão e Escalabilidade","expansion_description":"Planejamos expandir nossa capacidade produtiva através de uma rede global de fábricas estrategicamente localizadas, operando em um modelo de licenciamento e parceria. Iniciando no Brasil, nossa estratégia contempla expansão para mercados internacionais, aproveitando nossas patentes nos EUA e China para atender projetos globalmente com agilidade e custos logísticos otimizados.","strategic_partnerships_title":"Parcerias Estratégicas","strategic_partnerships_description":"Acreditamos no poder da colaboração internacional. Buscamos parcerias com construtoras, incorporadoras, governos e instituições de pesquisa nos mercados brasileiro e internacional para acelerar a adoção global da construção industrializada.","esg_commitment_title":"Compromisso ESG e Alinhamento com os ODS da ONU","esg_commitment_description":"Na vanguarda da Revolução Industrial 4.0, nosso modelo de negócio evolui em total consonância com os Objetivos de Desenvolvimento Sustentável (ODS), gerando impacto positivo e atendendo à agenda ESG.","ods_9_title":"ODS 9","ods_9_description":"Indústria, Inovação e Infraestrutura","ods_11_title":"ODS 11","ods_11_description":"Cidades e Comunidades Sustentáveis","ods_12_title":"ODS 12","ods_12_description":"Consumo e Produção Responsáveis","ods_13_title":"ODS 13","ods_13_description":"Ação Contra a Mudança Global do Clima","esg_benefits":"Além dos benefícios econômicos e de escala, nosso método construtivo atende à agenda ESG, pois promove uma substancial economia de recursos naturais e a consequente diminuição de atividades poluentes.","short_term_expansion_title":"Estratégia de expansão – Visão de Curto prazo","short_term_goal_1":"Implantação de no mínimo 10 fábricas nos próximos 5 anos.","short_term_goal_2":"Desenvolvimento de novos produtos e patentes complementares ao sistema existente.","model_advantages_title":"Vantagens do modelo:","model_advantage_1":"Demanda garantida pela produção das fábricas interligadas e estrategicamente posicionadas;","model_advantage_2":"Lucratividade equilibrada e sustentável;","model_advantage_3":"Economia de escala em insumos e recursos;","model_advantage_4":"Gestão centralizada de conhecimento e tecnologia.","strategic_expansion_map_alt":"Mapa estratégico de expansão industrial - iniciando em São Paulo com visão global","factory_location_map_alt":"Mapa de localização de fábricas - Estratégia de expansão global"},"partnerships":{"title":"Parcerias","knowledge_center_title":"Central de Conhecimentos e Parcerias Acadêmicas","knowledge_center_description":"Nossa estratégia de inovação é fundamentada em sólidas parcerias com universidades e instituições de pesquisa, garantindo validação científica, desenvolvimento contínuo e redução de riscos para nossos investidores.","research_ecosystem_title":"Ecossistema de Pesquisa e Validação","research_ecosystem_description_1":"Estabelecemos um robusto ecossistema de conhecimento através de parcerias estratégicas com as principais instituições de pesquisa do país. Esta abordagem garante a validação científica de nossa tecnologia e impulsiona a inovação contínua.","research_ecosystem_description_2":"Para os investidores, isso significa menor risco tecnológico, maior credibilidade no mercado e um pipeline constante de inovações que manterão nossa vantagem competitiva.","partner_universities":"Universidades Parceiras","partner_universities_description":"Colaboração acadêmica para pesquisa e desenvolvimento","knowledge_transfer":"Transferência de Conhecimento","knowledge_transfer_description":"Aplicação prática de pesquisas científicas","institutional_network":"Networking Institucional","institutional_network_description":"Rede de contatos estratégicos","scientific_validation":"Validação Científica","scientific_validation_description":"Credibilidade através de testes rigorosos","main_partnerships_title":"Principais Parcerias Institucionais","ipt_partnership_title":"IPT - Instituto de Pesquisas Tecnológicas","ipt_partnership_description_1":"O Instituto de Pesquisas Tecnológicas do Estado de São Paulo (IPT) é uma das mais tradicionais e renomadas instituições de pesquisa e inovação do Brasil, com uma história que remonta ao ano de 1899. Com mais de 125 anos dedicados ao desenvolvimento tecnológico, à pesquisa aplicada e à inovação aberta, o IPT tem desempenhado papel fundamental na transformação industrial, tecnológica e social do país.","ipt_partnership_description_2":"Por meio de sua atuação com a indústria da construção civil, em parceria com centros de pesquisa e outras ICTs, o IPT tem se consolidado como uma plataforma estratégica de inovação tecnológica em diversas áreas, incluindo sistemas construtivos industrializados destinados a habitações e edificações.","ipt_benefit_1":"Ensaios e certificações em laboratórios","ipt_benefit_2":"Validação de novas tecnologias e novas patentes","ipt_benefit_3":"Apoio na normatização técnica","ipt_benefit_4":"Redução de Riscos","ipt_benefit_5":"Credibilidade técnica","ipt_benefit_6":"Conformidade com normas","netpre_partnership_title":"Núcleo de Estudos e Tecnologia em Pré-Moldados de Concreto (NETPre)","netpre_partnership_description_1":"Núcleo de Estudos e Tecnologia em Pré-Moldados de Concreto (NETPre) da Universidade Federal de São Carlos (UFSCar) foi criado em 2004 a partir de um Programa de Pesquisa Pós-Doutoral em Centros Emergentes da FAPESP.","netpre_partnership_description_2":"Através do Convênio Institucional de Colaboração Tecnológica entre a UFSCar com a Associação Brasileira de Construção Industrializada de Concreto (ABCIC), foi construído em 2005 na UFSCar o primeiro laboratório dedicado ao estudo das Estruturas Pré-Moldadas de Concreto no Brasil.","netpre_benefit_1":"Pesquisa em pré-moldados de concreto e novos materiais","netpre_benefit_2":"Validação de novas tecnologias e novas patentes","netpre_benefit_3":"Inovação em sistemas construtivos","netpre_benefit_4":"Formação de recursos humanos","netpre_benefit_5":"Intercâmbio com tecnologias internacionais","netpre_benefit_6":"Laboratórios de materiais especializados","netpre_benefit_7":"Conformidade com normas","fumep_partnership_title":"FUMEP","fumep_partnership_description_1":"FUMEP ocupa atualmente mais de 25.000 metros quadrados de área construída, espaço utilizado por suas quatro unidades de ensino cursos de nível superior, cursos de pós-graduação, cursos técnicos e mais de cursos profissionalizantes, além do Ensino Médio.","fumep_partnership_description_2":"A estrutura mantém 42 laboratórios, 11 anfiteatros, salão nobre, ampla biblioteca, quadra esportiva, dois campos de futebol, cantina, restaurante, academia ao ar livre com pista de caminhada e estacionamento com 1.200 vagas.","fumep_partnership_description_3":"A FUMEP tem como principais atribuições o estímulo e o aperfeiçoamento do ensino e da pesquisa e a efetivação de convênios com universidades e entidades culturais, científicas e empresariais do setor público ou privado.","ipt_logo_alt":"Logo do IPT - Instituto de Pesquisas Tecnológicas","netpre_logo_alt":"Logo do NETPre - Núcleo de Estudos e Tecnologia em Pré-Moldados de Concreto","fumep_logo_alt":"Logo da FUMEP"},"market":{"title":"Oportunidades de Mercado","construction_revolution_title":"A Revolução da Construção Civil","construction_revolution_description_1":"O mercado da construção civil enfrenta um grande desafio: a necessidade de construir mais, mais rápido e com maior sustentabilidade. A construção tradicional, com seus longos prazos, desperdício de material e baixa produtividade, não consegue atender a essa demanda crescente.","construction_revolution_description_2":"A TECHSUS se posiciona como a solução para este gargalo. Nossa tecnologia de construção industrializada oferece uma alternativa viável e altamente competitiva.","market_segments_title":"Segmentos de Atuação","market_segments_description":"Nossa tecnologia é versátil e pode ser aplicada em uma ampla gama de projetos, atendendo a diversas demandas do mercado.","residential_title":"Residencial","residential_description":"Construção de casas e edifícios de apartamentos em larga escala, atendendo ao déficit habitacional com velocidade e qualidade.","commercial_industrial_title":"Comercial e Industrial","commercial_industrial_description":"Edificação de galpões, centros de distribuição, lojas e outras estruturas comerciais com prazos de entrega reduzidos.","institutional_title":"Institucional","institutional_description":"Construção de escolas, hospitais, creches e outros equipamentos públicos, garantindo agilidade para a administração pública.","hotel_title":"Hoteleiro","hotel_description":"Desenvolvimento de hotéis e resorts com construção ágil e padronizada, ideal para expansões de redes hoteleiras.","market_dashboard_title":"Dashboard de Oportunidades de Mercado","market_dashboard_description":"Dados consolidados que demonstram o imenso potencial de mercado e a urgente necessidade de soluções industrializadas para a construção civil brasileira.","global_market":"R$10.54T","global_market_description":"Mercado Global","global_market_detail":"10% do PIB mundial","sp_population":"45.97M","sp_population_description":"População SP (2024)","sp_population_detail":"+6.3% até 2030","housing_deficit_brazil":"6.2M","housing_deficit_brazil_description":"Déficit Habitacional Brasil","housing_deficit_brazil_detail":"8.3% do total nacional","housing_deficit_sp":"1.2M","housing_deficit_sp_description":"Déficit São Paulo","housing_deficit_sp_detail":"Maior do país","hospitals_title":"Hospitais","hospitals_new_units":"Novos até 2030:","hospitals_new_units_value":"+60 unidades","hospitals_investment":"Investimentos:","hospitals_investment_value":"R$ 4.2 bi","hospitals_deficit":"Déficit atual:","hospitals_deficit_value":"2.0 leitos/1000hab","education_title":"Educação","education_schools":"Escolas até 2030:","education_schools_value":"+135 unidades","education_daycare":"Creches até 2030:","education_daycare_value":"+67 unidades","education_investment":"Investimentos:","education_investment_value":"R$ 3.8 bi","hospitality_title":"Hotelaria","hospitality_segment":"Segmento:","hospitality_segment_value":"Corporativo/Luxo","hospitality_interior":"Interior:","hospitality_interior_value":"Resorts/Lazer","hospitality_investment":"Investimentos:","hospitality_investment_value":"R$ 2.8 bi","housing_programs_title":"Programas Habitacionais em Andamento","cdhu_goals_title":"CDHU - Metas 2025","cdhu_goal_1":"80 provas de conceito para homologação","cdhu_goal_2":"5.000 projetos habitacionais baseados em industrialização","cdhu_goal_3":"10.000 atendimentos em 2024","cdhu_goal_4":"12.000 atendimentos/ano (próximos 5 anos)","caixa_partnership_title":"Parceria CAIXA + Gov. SP","caixa_investment":"R$ 1 bilhão","caixa_investment_description":"Investimento Total","caixa_units":"~20 mil unidades","caixa_units_description":"Unidades Habitacionais","caixa_date":"Publicado em 08/04/2025","housing_deficit_dimension_title":"Dimensão do Déficit Habitacional","housing_deficit_dimension_description_1":"O Brasil enfrenta um déficit habitacional de 6.215.313 domicílios, representando 8,3% do total nacional. São Paulo lidera com 1,2 milhão de moradias em falta, enquanto 3,19 milhões de habitações não oferecem condições dignas.","housing_deficit_dimension_description_2":"A construção industrializada é a única solução capaz de atender essa demanda com a velocidade, qualidade e controle de custos necessários.","housing_deficit_impact":"O déficit pode afetar até 3,7 milhões de pessoas só em São Paulo, representando mais de 10% do total brasileiro.","construction_challenges_alt":"Infográfico sobre os desafios da construção civil","housing_deficit_map_alt":"Infográfico completo do déficit habitacional brasileiro","cdhu_logo_alt":"Logo da CDHU - Companhia de Desenvolvimento Habitacional e Urbano do Estado de São Paulo","caixa_logo_alt":"Logo da Caixa Econômica Federal"},"investors":{"title":"Relações com Investidores","investing_future_title":"Investindo na Construção do Futuro","investing_future_description_1":"A TECHSUS representa uma oportunidade única de investimento em um setor tradicional com enorme potencial de disrupção. Nossa tecnologia patenteada e modelo de negócio escalável nos posicionam para capturar uma parcela significativa de um dos maiores mercados da economia.","investing_future_description_2":"Oferecemos uma tese de investimento sólida, baseada em eficiência operacional, vantagens competitivas claras e um forte alinhamento com as tendências globais de sustentabilidade (ESG).","competitive_advantages_title":"Nossos Diferenciais Competitivos","competitive_advantages_description":"Nossa estratégia é fundamentada em pilares que garantem a sustentabilidade e o crescimento do negócio a longo prazo.","patented_technology_title":"Tecnologia Patenteada","patented_technology_description":"Proteção intelectual no Brasil, EUA e China, criando uma forte barreira de entrada e garantindo nossa exclusividade no mercado.","high_growth_market_title":"Mercado de Alto Crescimento","high_growth_market_description":"Atuação em um setor com demanda reprimida e um déficit habitacional de mais de 6 milhões de unidades no Brasil.","scalable_business_title":"Modelo de Negócio Escalável","scalable_business_description":"Expansão através de licenciamento e parcerias, permitindo um crescimento acelerado com menor necessidade de capital intensivo.","be_our_partner_title":"Seja nosso parceiro","be_our_partner_description":"Estamos abertos a conversas com investidores e parceiros estratégicos que desejam fazer parte da revolução da construção civil.","contact_button":"Entre em Contato","sao_paulo_skyline_alt":"Skyline de São Paulo com a Ponte Estaiada"},"live_cameras":{"title":"Câmeras ao Vivo","watch_operations_title":"Acompanhe Nossas Operações","watch_operations_description":"Veja em tempo real a eficiência e a precisão do nosso sistema construtivo em ação. (Imagens ilustrativas)","production_line_location":"Linha de Produção","panel_assembly_location":"Montagem de Painel","construction_site_location":"Canteiro de Obras","factory_yard_location":"Pátio da Fábrica","live_indicator":"LIVE","production_line_alt":"Câmera CAM-01 - Linha de Produção","panel_assembly_alt":"Câmera CAM-02 - Montagem de Painel","construction_site_alt":"Câmera CAM-03 - Canteiro de Obras","factory_yard_alt":"Câmera CAM-04 - Pátio da Fábrica"}}}],["$","$L4",null,{}],"$L9"]
