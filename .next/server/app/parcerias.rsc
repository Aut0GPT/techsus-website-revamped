",null,{"className":"flex items-start","children":[["$","span",null,{"className":"w-2 h-2 bg-orange-600 rounded-full mt-2 mr-3 flex-shrink-0"}],"Validação de novas tecnologias e novas patentes"]}],["$","li",null,{"className":"flex items-start","children":[["$","span",null,{"className":"w-2 h-2 bg-orange-600 rounded-full mt-2 mr-3 flex-shrink-0"}],"Inovação em sistemas construtivos"]}],["$","li",null,{"className":"flex items-start","children":[["$","span",null,{"className":"w-2 h-2 bg-orange-600 rounded-full mt-2 mr-3 flex-shrink-0"}],"Formação de recursos humanos"]}],["$","li",null,{"className":"flex items-start","children":[["$","span",null,{"className":"w-2 h-2 bg-orange-600 rounded-full mt-2 mr-3 flex-shrink-0"}],"Intercâmbio com tecnologias internacionais"]}],["$","li",null,{"className":"flex items-start","children":[["$","span",null,{"className":"w-2 h-2 bg-orange-600 rounded-full mt-2 mr-3 flex-shrink-0"}],"Laboratórios de materiais especializados"]}],["$","li",null,{"className":"flex items-start","children":[["$","span",null,{"className":"w-2 h-2 bg-orange-600 rounded-full mt-2 mr-3 flex-shrink-0"}],"Conformidade com normas"]}]]}]}]]}]]}]}],["$","div",null,{"className":"bg-white rounded-lg p-8 shadow-lg","children":["$","div",null,{"className":"flex flex-col md:flex-row gap-6 items-start","children":[["$","div",null,{"className":"flex-shrink-0","children":["$","$L2",null,{"src":"/images/imagenscomdescricao/Fumeplogo.jpg","alt":"Logo da FUMEP","width":120,"height":80,"className":"object-contain"}]}],["$","div",null,{"children":[["$","h4",null,{"className":"text-xl font-bold text-orange-600 mb-4","children":"FUMEP"}],["$","p",null,{"className":"text-stone-700 leading-relaxed","children":"FUMEP ocupa atualmente mais de 25.000 metros quadrados de área construída, espaço utilizado por suas quatro unidades de ensino cursos de nível superior, cursos de pós-graduação, cursos técnicos e mais de cursos profissionalizantes, além do Ensino Médio."}],["$","p",null,{"className":"text-stone-700 leading-relaxed mt-4","children":"A estrutura mantém 42 laboratórios, 11 anfiteatros, salão nobre, ampla biblioteca, quadra esportiva, dois campos de futebol, cantina, restaurante, academia ao ar livre com pista de caminhada e estacionamento com 1.200 vagas."}],["$","p",null,{"className":"text-stone-700 leading-relaxed mt-4","children":"A FUMEP tem como principais atribuições o estímulo e o aperfeiçoamento do ensino e da pesquisa e a efetivação de convênios com universidades e entidades culturais, científicas e empresariais do setor público ou privado."}]]}]]}]}]]}]]}]]}]}]]}]],null],null]},["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","parcerias","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"pt-BR","children":["$","body",null,{"className":"__className_fb8f2c antialiased bg-stone-50 text-stone-900","children":[["$","main",null,{"className":"min-h-screen","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":"$L5","templateStyles":[],"templateScripts":[],"notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{bord