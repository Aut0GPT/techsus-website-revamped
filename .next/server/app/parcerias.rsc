 credibilidade no mercado e um pipeline constante de inovações que manterão nossa vantagem competitiva."}]]}],["$","div",null,{"className":"grid grid-cols-2 gap-6","children":[["$","div",null,{"className":"bg-stone-50 p-6 rounded-lg shadow-lg text-center","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap h-12 w-12 text-orange-600 mx-auto mb-4","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"font-bold text-stone-900 mb-2","children":"Universidades Parceiras"}],["$","p",null,{"className":"text-stone-600 text-sm","children":"Colaboração acadêmica para pesquisa e desenvolvimento"}]]}],["$","div",null,{"className":"bg-stone-50 p-6 rounded-lg shadow-lg text-center","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open h-12 w-12 text-orange-600 mx-auto mb-4","children":[["$","path","vv98re",{"d":"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"}],["$","path","1cyq3y",{"d":"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"}],"$undefined"]}],["$","h4",null,{"className":"font-bold text-stone-900 mb-2","children":"Transferência de Conhecimento"}],["$","p",null,{"className":"text-stone-600 text-sm","children":"Aplicação prática de pesquisas científicas"}]]}],["$","div",null,{"className":"bg-stone-50 p-6 rounded-lg shadow-lg text-center","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 