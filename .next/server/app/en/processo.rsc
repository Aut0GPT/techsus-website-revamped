6:[["$","$La",null,{"locale":"en","dict":{"meta":{"title":"TECHSUS - Sustainable Industrialized Construction","description":"Industrialized construction system that revolutionizes civil construction with sustainability, efficiency and industrial quality. Self-supporting concrete panels with patented technology."},"navigation":{"home":"Home","about":"About Us","products":"Products","system":"System","process":"Process","strategy":"Strategy","partnerships":"Partnerships","market":"Market","investors":"Investors","live_cameras":"Live Cameras","contact":"Contact"},"hero":{"title":"Industrialized Construction with Sustainable Technology","subtitle":"Innovation and efficiency for modern civil construction, from design to delivery.","cta":"Contact Us"},"introduction":{"title":"Welcome to TECHSUS","subtitle":"We industrialize concrete walls and slabs to execute large volumes of buildings in reduced time, with zero waste and qualified workforce.","speed_title":"Speed","speed_description":"Up to 40% reduction in total construction time.","sustainability_title":"Sustainability","sustainability_description":"Natural resource savings and zero waste.","quality_title":"Superior Quality","quality_description":"Industrial control that eliminates pathologies and maintenance."},"process":{"title":"Our Process in Action","subtitle":"From factory to construction site, our method ensures efficiency and precision.","planning_title":"1. Planning","planning_description":"Coordination and development of detailed industrial projects.","manufacturing_title":"2. Manufacturing","manufacturing_description":"Industrial production in controlled environment with high precision.","logistics_title":"3. Logistics","logistics_description":"Safe and optimized transport to the construction site.","assembly_title":"4. Assembly","assembly_description":"Structure erected quickly and precisely on site.","main_title":"From Design to Reality: Efficiency in 4 Steps","main_description":"The TECHSUS system revolutionizes civil construction through an optimized process that ensures speed, quality and sustainability.","step1_title":"1. Coordination and development of industrial projects","step1_description":"Everything starts with detailed planning. Our engineering team uses advanced software to model the project, optimize panel layout and plan each stage of production and assembly, ensuring precision and efficiency.","step2_title":"2. Industrial Manufacturing (Off-site)","step2_description":"The process continues in our factory, where concrete panels are produced in a controlled environment. Using high-precision molds and automated machinery, we guarantee dimensional perfection, concrete quality and integration of all components, such as ducts and openings.","step3_title":"3. Logistics and Transportation","step3_description":"After curing and rigorous quality control, the panels are carefully loaded onto special vehicles. Logistics are planned to optimize transport time and ensure panels arrive at the construction site in perfect condition and in the correct order for assembly.","step4_title":"4. Rapid Assembly (On-site)","step4_description":"At the construction site, the magic happens. With the help of a crane, the panels are quickly lifted and positioned. Our specialized team performs the assembly, connecting the panels to form the building structure in a fraction of the time of conventional construction.","advantages_title":"Advantages of Our Process","advantage1_title":"Speed","advantage1_description":"Reduction of up to 40% in total construction time.","advantage2_title":"Controlled Quality","advantage2_description":"Industrial production ensures standard and precision.","advantage3_title":"Sustainability","advantage3_description":"Zero material waste on site."},"case_studies":{"title":"Success Cases and Proven Results","subtitle":"Our projects consistently demonstrate a 40% reduction in construction time, zero material waste and proven superior quality.","metrics":{"time_reduction":"Time Reduction","waste":"Material Waste","quality_control":"Quality Control","projects":"Delivered Projects"},"prototype_title":"Prototype House - São Simão/SP","prototype_description":"Pilot project delivered in February 2025 demonstrating our execution capacity with superior quality and accelerated deadlines.","prototype_area":"Built Area","prototype_time":"Total Time","prototype_testimonial":"The house turned out exactly as we planned, with perfect finishing and was delivered much faster than we expected.","building_title":"T+3 Building - Rio Claro/SP","building_description":"First vertical project demonstrating technology application in multi-story constructions with structural efficiency.","building_area":"Total Area","building_units":"Units","building_result":"Result: Complete structure assembled in 45% less time than traditional construction.","varzea_title":"House - Várzea Paulista/SP","varzea_description":"Single-family residence demonstrating architectural versatility of the system.","duque_title":"T+3 Building - Duque de Caxias/RJ","duque_description":"Regional expansion demonstrating scalability of the construction system.","premium_finish":"Premium Finish","deadline_met":"Deadline Met","optimized_logistics":"Optimized Logistics","certified_quality":"Certified Quality"},"technology":{"title":"Patented and Proven Technology","description":"Our construction system has intellectual protection in Brazil, USA and China, and is validated by rigorous tests in accredited laboratories such as IPT.","certification_text":"Technical certifications attest to normative compliance and superior quality of our industrialized process, ensuring safety and durability."},"cta":{"title":"Transform Your Construction with TECHSUS","subtitle":"Contact us and discover how our technology can accelerate your projects with more quality and sustainability.","button":"Request a Proposal"},"modal":{"close":"Close modal"},"footer":{"company_description":"Industrialized construction with sustainable and highly scalable technology.","quick_links":"Quick Links","company":"Company","system":"System","contact":"Contact","follow_us":"Follow Us","copyright":"All rights reserved."},"contact":{"title":"Contact","subtitle":"Contact Us","description":"We are available to answer questions, schedule meetings and present our innovative solutions for civil construction.","our_contacts":"Our Contacts","contact_person":"Contact","location":"Location","location_text":"São Paulo - SP, Brazil","send_message":"Send a Message","name":"Name","email":"Email","message":"Message","send_button":"Send Message"},"about":{"title":"About Us","company_title":"TECHSUS","company_description_1":"TECHSUS is a group of companies focused on the management and implementation of an innovative system for industrialized construction of bioclimatic structural concrete panels with patents applied for and granted in Brazil, China and the USA.","company_description_2":"Positioned at the forefront of Industrial Revolution 4.0 with automation and information modeling, this model evolves in line with the SDG agendas - Sustainable Development Goals.","sustainability_title":"Commitment to Sustainability","sustainability_description":"Positioned at the forefront of Industrial Revolution 4.0 with automation and information modeling, this model evolves in line with the SDG agendas - Sustainable Development Goals.","ods_9":"Industry, innovation and infrastructure","ods_11":"Sustainable cities and communities","ods_12":"Responsible consumption and production","ods_13":"Action against global climate change","esg_title":"ESG Agenda","esg_description":"In addition to economic and scale benefits, the construction method meets the ESG agenda, as there is substantial savings in natural resources and consequent reduction in polluting activities.","trajectory_title":"Trajectory and Validation","trajectory_description":"Our technology is the result of years of development and has validation from the most respected technical bodies.","patents_title":"Patents and Intellectual Property","patents_description":"The TECHSUS system is protected by patents in Brazil and the United States, ensuring our leading position in the market.","patent_brazil":"Brazil Patent","patent_usa":"United States Patent","patent_china":"China Patent","patent_brazil_org":"National Institute of Industrial Property (INPI)","patent_usa_org":"United States Patent and Trademark Office (USPTO)","patent_china_org":"State Intellectual Property Office of China (SIPO)","ipt_title":"IPT Technical Reports","ipt_description":"Complete validation from the Institute for Technological Research with performance, thermal, acoustic and durability tests.","ipt_performance":"System Performance","ipt_thermal":"Thermal Comfort","ipt_acoustic":"Acoustic Performance","ipt_durability":"Durability","certifications_title":"Official Certifications and Approvals","certifications_description":"Approvals from the main technical and governmental bodies, ensuring compliance with Brazilian standards.","datec_title":"DATEC Certificate","datec_description":"Technical Assessment Document","caixa_title":"Caixa Econômica Federal","caixa_description":"Official Approval","cdhu_title":"CDHU","cdhu_description":"Housing and Urban Development Company","sinat_title":"SINAT","sinat_description":"National System of Technical Approvals"},"system":{"title":"Construction System","main_title":"Technology and Innovation in Our DNA","main_description":"Our system is based on self-supporting concrete panels, produced industrially to ensure maximum quality, precision and performance.","panel_title":"The TECHSUS Panel","panel_description":"The heart of our system is the ribbed reinforced concrete panel. It consists of two concrete plates connected by trussed ribs, creating a hollow core that can be filled with insulating material or concrete, depending on project requirements.","panel_feature_1":"Lightweight and structural strength.","panel_feature_2":"Excellent thermal and acoustic performance.","panel_feature_3":"Electrical and hydraulic installations already embedded.","connections_title":"Smart Connections","connections_description":"The innovation of the system lies in how the panels connect, creating a robust monolithic structure with high performance through joint grouting.","connections_detail_1":"Types of ribs and connections between panels.","connections_detail_2":"Cross-section of the connection between panel and slab.","production_title":"From Factory Control to Assembly Agility","production_description":"We unite the best of both worlds: industrial precision and on-site assembly speed.","offsite_title":"Off-site Production","offsite_description":"Quality and precision guaranteed in an industrial environment.","onsite_title":"On-site Assembly","onsite_description":"Structure assembled in record time with minimal labor."},"products":{"title":"Products and Solutions","main_title":"Our Projects","main_description":"The TECHSUS system is applicable to a wide range of projects, from single-family homes to large residential and commercial complexes.","category1_title":"Single-Family Residential","category1_subtitle":"Single-Story Houses and Townhouses","category1_description":"Residential models that demonstrate the versatility and finishing quality of the TECHSUS system for single-family homes.","category2_title":"Multi-Family Buildings","category2_subtitle":"Residential Buildings","category2_description":"Multi-story residential buildings constructed with the system, proving its effectiveness in large-scale vertical projects.","category3_title":"Assembly Stages","category3_subtitle":"From foundation to structural enclosure walls","category3_description":"Overview of construction stages, from foundation to final assembly of panels on the construction site.","video_not_supported":"Your browser does not support the video element.","project_3d_label":"3D Project"},"strategy":{"title":"Our Strategy","future_vision_title":"Future Vision","future_vision_description":"Our strategy is to lead the global transformation of civil construction, starting in Brazil and expanding to international markets, making construction more efficient, sustainable and aligned with 21st-century demands.","expansion_title":"Expansion and Scalability","expansion_description":"We plan to expand our production capacity through a global network of strategically located factories, operating in a licensing and partnership model. Starting in Brazil, our strategy includes expansion to international markets, leveraging our patents in the US and China to serve projects globally with agility and optimized logistics costs.","strategic_partnerships_title":"Strategic Partnerships","strategic_partnerships_description":"We believe in the power of international collaboration. We seek partnerships with construction companies, developers, governments and research institutions in Brazilian and international markets to accelerate the global adoption of industrialized construction.","esg_commitment_title":"ESG Commitment and Alignment with UN SDGs","esg_commitment_description":"At the forefront of Industrial Revolution 4.0, our business model evolves in complete harmony with the Sustainable Development Goals (SDGs), generating positive impact and meeting the ESG agenda.","ods_9_title":"SDG 9","ods_9_description":"Industry, Innovation and Infrastructure","ods_11_title":"SDG 11","ods_11_description":"Sustainable Cities and Communities","ods_12_title":"SDG 12","ods_12_description":"Responsible Consumption and Production","ods_13_title":"SDG 13","ods_13_description":"Climate Action","esg_benefits":"Beyond economic and scale benefits, our construction method meets the ESG agenda, as it promotes substantial savings in natural resources and consequent reduction in polluting activities.","short_term_expansion_title":"Expansion Strategy – Short-term Vision","short_term_goal_1":"Implementation of at least 10 factories in the next 5 years.","short_term_goal_2":"Development of new products and patents complementary to the existing system.","model_advantages_title":"Model advantages:","model_advantage_1":"Guaranteed demand from interconnected and strategically positioned factory production;","model_advantage_2":"Balanced and sustainable profitability;","model_advantage_3":"Economy of scale in inputs and resources;","model_advantage_4":"Centralized knowledge and technology management.","strategic_expansion_map_alt":"Strategic industrial expansion map - starting in São Paulo with global vision","factory_location_map_alt":"Factory location map - Global expansion strategy"},"partnerships":{"title":"Partnerships","knowledge_center_title":"Knowledge Center and Academic Partnerships","knowledge_center_description":"Our innovation strategy is founded on solid partnerships with universities and research institutions, ensuring scientific validation, continuous development and risk reduction for our investors.","research_ecosystem_title":"Research and Validation Ecosystem","research_ecosystem_description_1":"We have established a robust knowledge ecosystem through strategic partnerships with the country's leading research institutions. This approach ensures scientific validation of our technology and drives continuous innovation.","research_ecosystem_description_2":"For investors, this means lower technological risk, greater market credibility and a constant pipeline of innovations that will maintain our competitive advantage.","partner_universities":"Partner Universities","partner_universities_description":"Academic collaboration for research and development","knowledge_transfer":"Knowledge Transfer","knowledge_transfer_description":"Practical application of scientific research","institutional_network":"Institutional Network","institutional_network_description":"Strategic contact network","scientific_validation":"Scientific Validation","scientific_validation_description":"Credibility through rigorous testing","main_partnerships_title":"Main Institutional Partnerships","ipt_partnership_title":"IPT - Institute for Technological Research","ipt_partnership_description_1":"The Institute for Technological Research of the State of São Paulo (IPT) is one of Brazil's most traditional and renowned research and innovation institutions, with a history dating back to 1899. With more than 125 years dedicated to technological development, applied research and open innovation, IPT has played a fundamental role in the country's industrial, technological and social transformation.","ipt_partnership_description_2":"Through its work with the civil construction industry, in partnership with research centers and other ICTs, IPT has consolidated itself as a strategic platform for technological innovation in various areas, including industrialized construction systems for housing and buildings.","ipt_benefit_1":"Laboratory testing and certifications","ipt_benefit_2":"Validation of new technologies and new patents","ipt_benefit_3":"Support in technical standardization","ipt_benefit_4":"Risk Reduction","ipt_benefit_5":"Technical credibility","ipt_benefit_6":"Compliance with standards","netpre_partnership_title":"Center for Studies and Technology in Precast Concrete (NETPre)","netpre_partnership_description_1":"Center for Studies and Technology in Precast Concrete (NETPre) at the Federal University of São Carlos (UFSCar) was created in 2004 from a Post-Doctoral Research Program in Emerging Centers by FAPESP.","netpre_partnership_description_2":"Through the Institutional Technology Collaboration Agreement between UFSCar and the Brazilian Association of Industrialized Concrete Construction (ABCIC), the first laboratory dedicated to the study of Precast Concrete Structures in Brazil was built at UFSCar in 2005.","netpre_benefit_1":"Research in precast concrete and new materials","netpre_benefit_2":"Validation of new technologies and new patents","netpre_benefit_3":"Innovation in construction systems","netpre_benefit_4":"Human resource development","netpre_benefit_5":"Exchange with international technologies","netpre_benefit_6":"Specialized materials laboratories","netpre_benefit_7":"Compliance with standards","fumep_partnership_title":"FUMEP","fumep_partnership_description_1":"FUMEP currently occupies more than 25,000 square meters of built area, space used by its four educational units: higher education courses, postgraduate courses, technical courses and more than professional courses, in addition to high school.","fumep_partnership_description_2":"The structure maintains 42 laboratories, 11 amphitheaters, noble hall, large library, sports court, two soccer fields, cafeteria, restaurant, outdoor gym with walking track and parking with 1,200 spaces.","fumep_partnership_description_3":"FUMEP's main attributions are to stimulate and improve teaching and research and to establish agreements with universities and cultural, scientific and business entities in the public or private sector.","ipt_logo_alt":"IPT logo - Institute for Technological Research","netpre_logo_alt":"NETPre logo - Center for Studies and Technology in Precast Concrete","fumep_logo_alt":"FUMEP logo"},"market":{"title":"Market Opportunities","construction_revolution_title":"The Construction Revolution","construction_revolution_description_1":"The civil construction market faces a major challenge: the need to build more, faster and with greater sustainability. Traditional construction, with its long deadlines, material waste and low productivity, cannot meet this growing demand.","construction_revolution_description_2":"TECHSUS positions itself as the solution to this bottleneck. Our industrialized construction technology offers a viable and highly competitive alternative.","market_segments_title":"Operating Segments","market_segments_description":"Our technology is versatile and can be applied to a wide range of projects, meeting various market demands.","residential_title":"Residential","residential_description":"Construction of houses and apartment buildings on a large scale, addressing the housing deficit with speed and quality.","commercial_industrial_title":"Commercial and Industrial","commercial_industrial_description":"Construction of warehouses, distribution centers, stores and other commercial structures with reduced delivery times.","institutional_title":"Institutional","institutional_description":"Construction of schools, hospitals, daycare centers and other public facilities, ensuring agility for public administration.","hotel_title":"Hotel","hotel_description":"Development of hotels and resorts with agile and standardized construction, ideal for hotel chain expansions.","market_dashboard_title":"Market Opportunities Dashboard","market_dashboard_description":"Consolidated data demonstrating the immense market potential and urgent need for industrialized solutions for Brazilian civil construction.","global_market":"$$10.54T","global_market_description":"Global Market","global_market_detail":"10% of world GDP","sp_population":"45.97M","sp_population_description":"SP Population (2024)","sp_population_detail":"+6.3% until 2030","housing_deficit_brazil":"6.2M","housing_deficit_brazil_description":"Housing Deficit Brazil","housing_deficit_brazil_detail":"8.3% of national total","housing_deficit_sp":"1.2M","housing_deficit_sp_description":"São Paulo Deficit","housing_deficit_sp_detail":"Largest in the country","hospitals_title":"Hospitals","hospitals_new_units":"New until 2030:","hospitals_new_units_value":"+60 units","hospitals_investment":"Investments:","hospitals_investment_value":"$$4.2 billion","hospitals_deficit":"Current deficit:","hospitals_deficit_value":"2.0 beds/1000 inhabitants","education_title":"Education","education_schools":"Schools until 2030:","education_schools_value":"+135 units","education_daycare":"Daycare centers until 2030:","education_daycare_value":"+67 units","education_investment":"Investments:","education_investment_value":"$$3.8 billion","hospitality_title":"Hospitality","hospitality_segment":"Segment:","hospitality_segment_value":"Corporate/Luxury","hospitality_interior":"Interior:","hospitality_interior_value":"Resorts/Leisure","hospitality_investment":"Investments:","hospitality_investment_value":"$$2.8 billion","housing_programs_title":"Ongoing Housing Programs","cdhu_goals_title":"CDHU - 2025 Goals","cdhu_goal_1":"80 proof of concepts for approval","cdhu_goal_2":"5,000 housing projects based on industrialization","cdhu_goal_3":"10,000 services in 2024","cdhu_goal_4":"12,000 services/year (next 5 years)","caixa_partnership_title":"CAIXA + SP Gov. Partnership","caixa_investment":"$$1 billion","caixa_investment_description":"Total Investment","caixa_units":"~20 thousand units","caixa_units_description":"Housing Units","caixa_date":"Published on 04/08/2025","housing_deficit_dimension_title":"Housing Deficit Dimension","housing_deficit_dimension_description_1":"Brazil faces a housing deficit of 6,215,313 households, representing 8.3% of the national total. São Paulo leads with 1.2 million missing homes, while 3.19 million dwellings do not offer decent conditions.","housing_deficit_dimension_description_2":"Industrialized construction is the only solution capable of meeting this demand with the necessary speed, quality and cost control.","housing_deficit_impact":"The deficit can affect up to 3.7 million people in São Paulo alone, representing more than 10% of the Brazilian total.","construction_challenges_alt":"Infographic about civil construction challenges","housing_deficit_map_alt":"Complete infographic of Brazilian housing deficit","cdhu_logo_alt":"CDHU logo - Housing and Urban Development Company of the State of São Paulo","caixa_logo_alt":"Caixa Econômica Federal logo"},"investors":{"title":"Investor Relations","investing_future_title":"Investing in the Construction of the Future","investing_future_description_1":"TECHSUS represents a unique investment opportunity in a traditional sector with enormous disruption potential. Our patented technology and scalable business model position us to capture a significant share of one of the economy's largest markets.","investing_future_description_2":"We offer a solid investment thesis, based on operational efficiency, clear competitive advantages and strong alignment with global sustainability trends (ESG).","competitive_advantages_title":"Our Competitive Differentials","competitive_advantages_description":"Our strategy is founded on pillars that guarantee the sustainability and long-term business growth.","patented_technology_title":"Patented Technology","patented_technology_description":"Intellectual protection in Brazil, USA and China, creating a strong entry barrier and guaranteeing our market exclusivity.","high_growth_market_title":"High Growth Market","high_growth_market_description":"Operating in a sector with pent-up demand and a housing deficit of more than 6 million units in Brazil.","scalable_business_title":"Scalable Business Model","scalable_business_description":"Expansion through licensing and partnerships, allowing accelerated growth with lower capital-intensive requirements.","be_our_partner_title":"Be our partner","be_our_partner_description":"We are open to conversations with investors and strategic partners who want to be part of the civil construction revolution.","contact_button":"Contact Us","sao_paulo_skyline_alt":"São Paulo skyline with the Cable-Stayed Bridge"},"live_cameras":{"title":"Live Cameras","watch_operations_title":"Watch Our Operations","watch_operations_description":"See in real time the efficiency and precision of our construction system in action. (Illustrative images)","production_line_location":"Production Line","panel_assembly_location":"Panel Assembly","construction_site_location":"Construction Site","factory_yard_location":"Factory Yard","live_indicator":"LIVE","production_line_alt":"Camera CAM-01 - Production Line","panel_assembly_alt":"Camera CAM-02 - Panel Assembly","construction_site_alt":"Camera CAM-03 - Construction Site","factory_yard_alt":"Camera CAM-04 - Factory Yard"},"common":{"loading":"Loading..."}}}],["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","en","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],"$Lb"]
7:[["$","$La",null,{"locale":"pt","dict":{"meta":{"title":"TECHSUS - Construção Industrializada Sustentável","description":"Sistema construtivo industrializado que revoluciona a construção civil com sustentabilidade, eficiência e qualidade industrial. Painéis de concreto autoportantes com tecnologia patenteada."},"navigation":{"home":"Início","about":"Quem Somos","products":"Produtos","system":"Sistema","process":"Processo","strategy":"Estratégia","partnerships":"Parcerias","market":"Mercado","investors":"Investidores","live_cameras":"Câmeras ao Vivo","contact":"Contato"},"hero":{"title":"Construção Industrializada com Tecnologia Sustentável","subtitle":"Inovação e eficiência para a construção civil moderna, do projeto à entrega.","cta":"Entre em Contato"},"introduction":{"title":"Bem-vindo à TECHSUS","subtitle":"Industrializamos paredes e lajes em concreto para executar grandes volumes de edificações em tempo reduzido, com desperdício zero e mão de obra qualificada.","speed_title":"Velocidade","speed_description":"Redução de até 40% no tempo total da obra.","sustainability_title":"Sustentabilidade","sustainability_description":"Economia de recursos naturais e zero desperdício.","quality_title":"Qualidade Superior","quality_description":"Controle industrial que elimina patologias e manutenções."},"process":{"title":"Nosso Processo em Ação","subtitle":"Da fábrica ao canteiro de obras, nosso método garante eficiência e precisão.","planning_title":"1. Planejamento","planning_description":"Compatibilização e desenvolvimento de projetos industriais detalhados.","manufacturing_title":"2. Fabricação","manufacturing_description":"Produção industrial em ambiente controlado com alta precisão.","logistics_title":"3. Logística","logistics_description":"Transporte seguro e otimizado para o canteiro de obras.","assembly_title":"4. Montagem","assembly_description":"Estrutura erguida com rapidez e precisão no local.","main_title":"Do Projeto à Realidade: Eficiência em 4 Etapas","main_description":"O sistema TECHSUS revoluciona a construção civil através de um processo otimizado que garante velocidade, qualidade e sustentabilidade.","step1_title":"1. Compatibilização e o desenvolvimento de projetos industriais","step1_description":"Tudo começa com um planejamento detalhado. Nossa equipe de engenharia utiliza softwares avançados para modelar o projeto, otimizar o layout dos painéis e planejar cada etapa da produção e montagem, garantindo precisão e eficiência.","step2_title":"2. Fabricação Industrial (Off-site)","step2_description":"O processo continua em nossa fábrica, onde os painéis de concreto são produzidos em um ambiente controlado. Utilizando moldes de alta precisão e maquinário automatizado, garantimos a perfeição dimensional, a qualidade do concreto e a integração de todos os componentes, como dutos e vãos.","step3_title":"3. Logística e Transporte","step3_description":"Após a cura e um rigoroso controle de qualidade, os painéis são cuidadosamente carregados em veículos especiais. A logística é planejada para otimizar o tempo de transporte e garantir que os painéis cheguem ao canteiro de obras em perfeitas condições e na ordem correta para a montagem.","step4_title":"4. Montagem Rápida (On-site)","step4_description":"No canteiro de obras, a magia acontece. Com o auxílio de um guindaste, os painéis são rapidamente içados e posicionados. Nossa equipe especializada realiza a montagem, conectando os painéis para formar a estrutura da edificação em uma fração do tempo de uma construção convencional.","advantages_title":"Vantagens do Nosso Processo","advantage1_title":"Velocidade","advantage1_description":"Redução de até 40% no tempo total da obra.","advantage2_title":"Qualidade Controlada","advantage2_description":"Produção industrial garante padrão e precisão.","advantage3_title":"Sustentabilidade","advantage3_description":"Zero desperdício de materiais no canteiro."},"case_studies":{"title":"Cases de Sucesso e Resultados Comprovados","subtitle":"Nossos projetos demonstram consistentemente uma redução de 40% no tempo de construção, zero desperdício de materiais e qualidade superior comprovada.","metrics":{"time_reduction":"Redução de Tempo","waste":"Desperdício de Material","quality_control":"Controle de Qualidade","projects":"Projetos Entregues"},"prototype_title":"Casa Protótipo - São Simão/SP","prototype_description":"Projeto-piloto entregue em Fevereiro de 2025 demonstrando nossa capacidade de execução com qualidade superior e prazos acelerados.","prototype_area":"Área Construída","prototype_time":"Tempo Total","prototype_testimonial":"A casa ficou exatamente como planejamos, com acabamento perfeito e foi entregue muito mais rápido do que esperávamos.","building_title":"Edifício T+3 - Rio Claro/SP","building_description":"Primeiro projeto vertical demonstrando a aplicação da tecnologia em construções de múltiplos pavimentos com eficiência estrutural.","building_area":"Área Total","building_units":"Unidades","building_result":"Resultado: Estrutura completa montada em 45% menos tempo que construção tradicional.","varzea_title":"Casa - Várzea Paulista/SP","varzea_description":"Residência unifamiliar demonstrando versatilidade arquitetônica do sistema.","duque_title":"Edifício T+3 - Duque de Caxias/RJ","duque_description":"Expansão regional demonstrando escalabilidade do sistema construtivo.","premium_finish":"Acabamento Premium","deadline_met":"Prazo Cumprido","optimized_logistics":"Logística Otimizada","certified_quality":"Qualidade Certificada"},"technology":{"title":"Tecnologia Patenteada e Comprovada","description":"Nosso sistema construtivo possui proteção intelectual no Brasil, EUA e China, além de ser validado por rigorosos testes em laboratórios credenciados como o IPT.","certification_text":"As certificações técnicas atestam a conformidade normativa e a qualidade superior do nosso processo industrializado, garantindo segurança e durabilidade."},"cta":{"title":"Transforme sua Construção com a TECHSUS","subtitle":"Entre em contato e descubra como nossa tecnologia pode acelerar seus projetos com mais qualidade e sustentabilidade.","button":"Solicitar uma Proposta"},"modal":{"close":"Fechar modal"},"footer":{"company_description":"Construção industrializada com tecnologia sustentável e altamente escalável.","quick_links":"Links Rápidos","company":"Empresa","system":"Sistema","contact":"Contato","follow_us":"Siga-nos","copyright":"Todos os direitos reservados."},"contact":{"title":"Contato","subtitle":"Fale Conosco","description":"Estamos à disposição para esclarecer dúvidas, agendar reuniões e apresentar nossas soluções inovadoras para a construção civil.","our_contacts":"Nossos Contatos","contact_person":"Contato","location":"Localização","location_text":"São Paulo - SP, Brasil","send_message":"Envie uma Mensagem","name":"Nome","email":"E-mail","message":"Mensagem","send_button":"Enviar Mensagem"},"about":{"title":"Quem Somos","company_title":"A TECHSUS","company_description_1":"A TECHSUS é um grupo de empresas voltadas à gestão e implantação de um sistema inovador para a construção industrializada de painéis estruturais bioclimáticos de concreto com patentes requeridas e concedidas no Brasil, China e EUA.","company_description_2":"Posicionada na vanguarda da Revolução Industrial 4.0 com automação e modelagem de informação, esse modelo evolui em consonância com as agendas ODS - Objetivos de Desenvolvimento Sustentável.","sustainability_title":"Compromisso com a Sustentabilidade","sustainability_description":"Posicionada na vanguarda da Revolução Industrial 4.0 com automação e modelagem de informação, esse modelo evolui em consonância com as agendas ODS - Objetivos de Desenvolvimento Sustentável.","ods_9":"Indústria, inovação e infraestrutura","ods_11":"Cidades e comunidades sustentáveis","ods_12":"Consumo e produção responsáveis","ods_13":"Ação contra mudança global do clima","esg_title":"Agenda ESG","esg_description":"Além dos benefícios econômicos e de escala, o método construtivo atende a agenda ESG, já que há substancial economia de recursos naturais e consequente diminuição de atividades poluentes.","trajectory_title":"Trajetória e Validação","trajectory_description":"Nossa tecnologia é fruto de anos de desenvolvimento e possui validação dos mais respeitados órgãos técnicos.","patents_title":"Patentes e Propriedade Intelectual","patents_description":"O sistema TECHSUS é protegido por patentes no Brasil e nos Estados Unidos, garantindo nossa posição de vanguarda no mercado.","patent_brazil":"Patente Brasil","patent_usa":"Patente Estados Unidos","patent_china":"Patente China","patent_brazil_org":"Instituto Nacional da Propriedade Industrial (INPI)","patent_usa_org":"United States Patent and Trademark Office (USPTO)","patent_china_org":"Escritório Estatal de Propriedade Intelectual da China (SIPO)","ipt_title":"Relatórios Técnicos IPT","ipt_description":"Validação completa do Instituto de Pesquisas Tecnológicas com ensaios de desempenho, térmica, acústica e durabilidade.","ipt_performance":"Desempenho do Sistema","ipt_thermal":"Conforto Térmico","ipt_acoustic":"Desempenho Acústico","ipt_durability":"Durabilidade","certifications_title":"Certificações e Homologações Oficiais","certifications_description":"Homologações dos principais órgãos técnicos e governamentais, garantindo conformidade com as normas brasileiras.","datec_title":"Certificado DATEC","datec_description":"Documento de Avaliação Técnica","caixa_title":"Caixa Econômica Federal","caixa_description":"Homologação Oficial","cdhu_title":"CDHU","cdhu_description":"Companhia de Desenvolvimento Habitacional","sinat_title":"SINAT","sinat_description":"Sistema Nacional de Aprovações Técnicas"},"system":{"title":"Sistema Construtivo","main_title":"Tecnologia e Inovação no DNA","main_description":"Nosso sistema é baseado em painéis de concreto autoportantes, produzidos industrialmente para garantir máxima qualidade, precisão e desempenho.","panel_title":"O Painel TECHSUS","panel_description":"O coração do nosso sistema é o painel nervurado de concreto armado. Ele é composto por duas placas de concreto conectadas por nervuras treliçadas, criando um núcleo oco que pode ser preenchido com material isolante ou concreto, conforme a necessidade do projeto.","panel_feature_1":"Leveza e resistência estrutural.","panel_feature_2":"Excelente desempenho térmico e acústico.","panel_feature_3":"Instalações elétricas e hidráulicas já embutidas.","connections_title":"Conexões Inteligentes","connections_description":"A inovação do sistema reside na forma como os painéis se conectam, criando uma estrutura monolítica robusta e de alta performance através do grauteamento das juntas.","connections_detail_1":"Tipos de nervuras e ligações entre painéis.","connections_detail_2":"Seção transversal da conexão entre painel e laje.","production_title":"Do Controle da Fábrica à Agilidade na Montagem","production_description":"Unimos o melhor dos dois mundos: a precisão da indústria e a rapidez da montagem no local.","offsite_title":"Produção Off-site","offsite_description":"Qualidade e precisão garantidas em ambiente industrial.","onsite_title":"Montagem On-site","onsite_description":"Estrutura montada em tempo recorde com mínimo de mão de obra."},"products":{"title":"Produtos e Soluções","main_title":"Nossos Projetos","main_description":"O sistema TECHSUS é aplicável a uma vasta gama de projetos, desde casas unifamiliares a grandes complexos residenciais e comerciais.","category1_title":"Residencial Unifamiliar","category1_subtitle":"Casas Térreas e Sobrados","category1_description":"Modelos de residências que demonstram a versatilidade e a qualidade de acabamento do sistema TECHSUS para moradias unifamiliares.","category2_title":"Edifícios Multifamiliares","category2_subtitle":"Prédios Habitacionais","category2_description":"Edifícios residenciais de múltiplos andares construídos com o sistema, provando sua eficácia em projetos verticais de grande escala.","category3_title":"Etapas de Montagem","category3_subtitle":"Do alicerce até paredes estruturais de vedação","category3_description":"Visão geral das etapas de construção, desde a fundação até a montagem final dos painéis no canteiro de obras.","video_not_supported":"Seu navegador não suporta o elemento de vídeo.","project_3d_label":"Projeto 3D"},"strategy":{"title":"Nossa Estratégia","future_vision_title":"Visão de Futuro","future_vision_description":"Nossa estratégia é liderar a transformação global da construção civil, iniciando no Brasil e expandindo para mercados internacionais, tornando a construção mais eficiente, sustentável e alinhada às demandas do século 21.","expansion_title":"Expansão e Escalabilidade","expansion_description":"Planejamos expandir nossa capacidade produtiva através de uma rede global de fábricas estrategicamente localizadas, operando em um modelo de licenciamento e parceria. Iniciando no Brasil, nossa estratégia contempla expansão para mercados internacionais, aproveitando nossas patentes nos EUA e China para atender projetos globalmente com agilidade e custos logísticos otimizados.","strategic_partnerships_title":"Parcerias Estratégicas","strategic_partnerships_description":"Acreditamos no poder da colaboração internacional. Buscamos parcerias com construtoras, incorporadoras, governos e instituições de pesquisa nos mercados brasileiro e internacional para acelerar a adoção global da construção industrializada.","esg_commitment_title":"Compromisso ESG e Alinhamento com os ODS da ONU","esg_commitment_description":"Na vanguarda da Revolução Industrial 4.0, nosso modelo de negócio evolui em total consonância com os Objetivos de Desenvolvimento Sustentável (ODS), gerando impacto positivo e atendendo à agenda ESG.","ods_9_title":"ODS 9","ods_9_description":"Indústria, Inovação e Infraestrutura","ods_11_title":"ODS 11","ods_11_description":"Cidades e Comunidades Sustentáveis","ods_12_title":"ODS 12","ods_12_description":"Consumo e Produção Responsáveis","ods_13_title":"ODS 13","ods_13_description":"Ação Contra a Mudança Global do Clima","esg_benefits":"Além dos benefícios econômicos e de escala, nosso método construtivo atende à agenda ESG, pois promove uma substancial economia de recursos naturais e a consequente diminuição de atividades poluentes.","short_term_expansion_title":"Estratégia de expansão – Visão de Curto prazo","short_term_goal_1":"Implantação de no mínimo 10 fábricas nos próximos 5 anos.","short_term_goal_2":"Desenvolvimento de novos produtos e patentes complementares ao sistema existente.","model_advantages_title":"Vantagens do modelo:","model_advantage_1":"Demanda garantida pela produção das fábricas interligadas e estrategicamente posicionadas;","model_advantage_2":"Lucratividade equilibrada e sustentável;","model_advantage_3":"Economia de escala em insumos e recursos;","model_advantage_4":"Gestão centralizada de conhecimento e tecnologia.","strategic_expansion_map_alt":"Mapa estratégico de expansão industrial - iniciando em São Paulo com visão global","factory_location_map_alt":"Mapa de localização de fábricas - Estratégia de expansão global"},"partnerships":{"title":"Parcerias","knowledge_center_title":"Central de Conhecimentos e Parcerias Acadêmicas","knowledge_center_description":"Nossa estratégia de inovação é fundamentada em sólidas parcerias com universidades e instituições de pesquisa, garantindo validação científica, desenvolvimento contínuo e redução de riscos para nossos investidores.","research_ecosystem_title":"Ecossistema de Pesquisa e Validação","research_ecosystem_description_1":"Estabelecemos um robusto ecossistema de conhecimento através de parcerias estratégicas com as principais instituições de pesquisa do país. Esta abordagem garante a validação científica de nossa tecnologia e impulsiona a inovação contínua.","research_ecosystem_description_2":"Para os investidores, isso significa menor risco tecnológico, maior credibilidade no mercado e um pipeline constante de inovações que manterão nossa vantagem competitiva.","partner_universities":"Universidades Parceiras","partner_universities_description":"Colaboração acadêmica para pesquisa e desenvolvimento","knowledge_transfer":"Transferência de Conhecimento","knowledge_transfer_description":"Aplicação prática de pesquisas científicas","institutional_network":"Networking Institucional","institutional_network_description":"Rede de contatos estratégicos","scientific_validation":"Validação Científica","scientific_validation_description":"Credibilidade através de testes rigorosos","main_partnerships_title":"Principais Parcerias Institucionais","ipt_partnership_title":"IPT - Instituto de Pesquisas Tecnológicas","ipt_partnership_description_1":"O Instituto de Pesquisas Tecnológicas do Estado de São Paulo (IPT) é uma das mais tradicionais e renomadas instituições de pesquisa e inovação do Brasil, com uma história que remonta ao ano de 1899. Com mais de 125 anos dedicados ao desenvolvimento tecnológico, à pesquisa aplicada e à inovação aberta, o IPT tem desempenhado papel fundamental na transformação industrial, tecnológica e social do país.","ipt_partnership_description_2":"Por meio de sua atuação com a indústria da construção civil, em parceria com centros de pesquisa e outras ICTs, o IPT tem se consolidado como uma plataforma estratégica de inovação tecnológica em diversas áreas, incluindo sistemas construtivos industrializados destinados a habitações e edificações.","ipt_benefit_1":"Ensaios e certificações em laboratórios","ipt_benefit_2":"Validação de novas tecnologias e novas patentes","ipt_benefit_3":"Apoio na normatização técnica","ipt_benefit_4":"Redução de Riscos","ipt_benefit_5":"Credibilidade técnica","ipt_benefit_6":"Conformidade com normas","netpre_partnership_title":"Núcleo de Estudos e Tecnologia em Pré-Moldados de Concreto (NETPre)","netpre_partnership_description_1":"Núcleo de Estudos e Tecnologia em Pré-Moldados de Concreto (NETPre) da Universidade Federal de São Carlos (UFSCar) foi criado em 2004 a partir de um Programa de Pesquisa Pós-Doutoral em Centros Emergentes da FAPESP.","netpre_partnership_description_2":"Através do Convênio Institucional de Colaboração Tecnológica entre a UFSCar com a Associação Brasileira de Construção Industrializada de Concreto (ABCIC), foi construído em 2005 na UFSCar o primeiro laboratório dedicado ao estudo das Estruturas Pré-Moldadas de Concreto no Brasil.","netpre_benefit_1":"Pesquisa em pré-moldados de concreto e novos materiais","netpre_benefit_2":"Validação de novas tecnologias e novas patentes","netpre_benefit_3":"Inovação em sistemas construtivos","netpre_benefit_4":"Formação de recursos humanos","netpre_benefit_5":"Intercâmbio com tecnologias internacionais","netpre_benefit_6":"Laboratórios de materiais especializados","netpre_benefit_7":"Conformidade com normas","fumep_partnership_title":"FUMEP","fumep_partnership_description_1":"FUMEP ocupa atualmente mais de 25.000 metros quadrados de área construída, espaço utilizado por suas quatro unidades de ensino cursos de nível superior, cursos de pós-graduação, cursos técnicos e mais de cursos profissionalizantes, além do Ensino Médio.","fumep_partnership_description_2":"A estrutura mantém 42 laboratórios, 11 anfiteatros, salão nobre, ampla biblioteca, quadra esportiva, dois campos de futebol, cantina, restaurante, academia ao ar livre com pista de caminhada e estacionamento com 1.200 vagas.","fumep_partnership_description_3":"A FUMEP tem como principais atribuições o estímulo e o aperfeiçoamento do ensino e da pesquisa e a efetivação de convênios com universidades e entidades culturais, científicas e empresariais do setor público ou privado.","ipt_logo_alt":"Logo do IPT - Instituto de Pesquisas Tecnológicas","netpre_logo_alt":"Logo do NETPre - Núcleo de Estudos e Tecnologia em Pré-Moldados de Concreto","fumep_logo_alt":"Logo da FUMEP"},"market":{"title":"Oportunidades de Mercado","construction_revolution_title":"A Revolução da Construção Civil","construction_revolution_description_1":"O mercado da construção civil enfrenta um grande desafio: a necessidade de construir mais, mais rápido e com maior sustentabilidade. A construção tradicional, com seus longos prazos, desperdício de material e baixa produtividade, não consegue atender a essa demanda crescente.","construction_revolution_description_2":"A TECHSUS se posiciona como a solução para este gargalo. Nossa tecnologia de construção industrializada oferece uma alternativa viável e altamente competitiva.","market_segments_title":"Segmentos de Atuação","market_segments_description":"Nossa tecnologia é versátil e pode ser aplicada em uma ampla gama de projetos, atendendo a diversas demandas do mercado.","residential_title":"Residencial","residential_description":"Construção de casas e edifícios de apartamentos em larga escala, atendendo ao déficit habitacional com velocidade e qualidade.","commercial_industrial_title":"Comercial e Industrial","commercial_industrial_description":"Edificação de galpões, centros de distribuição, lojas e outras estruturas comerciais com prazos de entrega reduzidos.","institutional_title":"Institucional","institutional_description":"Construção de escolas, hospitais, creches e outros equipamentos públicos, garantindo agilidade para a administração pública.","hotel_title":"Hoteleiro","hotel_description":"Desenvolvimento de hotéis e resorts com construção ágil e padronizada, ideal para expansões de redes hoteleiras.","market_dashboard_title":"Dashboard de Oportunidades de Mercado","market_dashboard_description":"Dados consolidados que demonstram o imenso potencial de mercado e a urgente necessidade de soluções industrializadas para a construção civil brasileira.","global_market":"R$10.54T","global_market_description":"Mercado Global","global_market_detail":"10% do PIB mundial","sp_population":"45.97M","sp_population_description":"População SP (2024)","sp_population_detail":"+6.3% até 2030","housing_deficit_brazil":"6.2M","housing_deficit_brazil_description":"Déficit Habitacional Brasil","housing_deficit_brazil_detail":"8.3% do total nacional","housing_deficit_sp":"1.2M","housing_deficit_sp_description":"Déficit São Paulo","housing_deficit_sp_detail":"Maior do país","hospitals_title":"Hospitais","hospitals_new_units":"Novos até 2030:","hospitals_new_units_value":"+60 unidades","hospitals_investment":"Investimentos:","hospitals_investment_value":"R$ 4.2 bi","hospitals_deficit":"Déficit atual:","hospitals_deficit_value":"2.0 leitos/1000hab","education_title":"Educação","education_schools":"Escolas até 2030:","education_schools_value":"+135 unidades","education_daycare":"Creches até 2030:","education_daycare_value":"+67 unidades","education_investment":"Investimentos:","education_investment_value":"R$ 3.8 bi","hospitality_title":"Hotelaria","hospitality_segment":"Segmento:","hospitality_segment_value":"Corporativo/Luxo","hospitality_interior":"Interior:","hospitality_interior_value":"Resorts/Lazer","hospitality_investment":"Investimentos:","hospitality_investment_value":"R$ 2.8 bi","housing_programs_title":"Programas Habitacionais em Andamento","cdhu_goals_title":"CDHU - Metas 2025","cdhu_goal_1":"80 provas de conceito para homologação","cdhu_goal_2":"5.000 projetos habitacionais baseados em industrialização","cdhu_goal_3":"10.000 atendimentos em 2024","cdhu_goal_4":"12.000 atendimentos/ano (próximos 5 anos)","caixa_partnership_title":"Parceria CAIXA + Gov. SP","caixa_investment":"R$ 1 bilhão","caixa_investment_description":"Investimento Total","caixa_units":"~20 mil unidades","caixa_units_description":"Unidades Habitacionais","caixa_date":"Publicado em 08/04/2025","housing_deficit_dimension_title":"Dimensão do Déficit Habitacional","housing_deficit_dimension_description_1":"O Brasil enfrenta um déficit habitacional de 6.215.313 domicílios, representando 8,3% do total nacional. São Paulo lidera com 1,2 milhão de moradias em falta, enquanto 3,19 milhões de habitações não oferecem condições dignas.","housing_deficit_dimension_description_2":"A construção industrializada é a única solução capaz de atender essa demanda com a velocidade, qualidade e controle de custos necessários.","housing_deficit_impact":"O déficit pode afetar até 3,7 milhões de pessoas só em São Paulo, representando mais de 10% do total brasileiro.","construction_challenges_alt":"Infográfico sobre os desafios da construção civil","housing_deficit_map_alt":"Infográfico completo do déficit habitacional brasileiro","cdhu_logo_alt":"Logo da CDHU - Companhia de Desenvolvimento Habitacional e Urbano do Estado de São Paulo","caixa_logo_alt":"Logo da Caixa Econômica Federal"},"investors":{"title":"Relações com Investidores","investing_future_title":"Investindo na Construção do Futuro","investing_future_description_1":"A TECHSUS representa uma oportunidade única de investimento em um setor tradicional com enorme potencial de disrupção. Nossa tecnologia patenteada e modelo de negócio escalável nos posicionam para capturar uma parcela significativa de um dos maiores mercados da economia.","investing_future_description_2":"Oferecemos uma tese de investimento sólida, baseada em eficiência operacional, vantagens competitivas claras e um forte alinhamento com as tendências globais de sustentabilidade (ESG).","competitive_advantages_title":"Nossos Diferenciais Competitivos","competitive_advantages_description":"Nossa estratégia é fundamentada em pilares que garantem a sustentabilidade e o crescimento do negócio a longo prazo.","patented_technology_title":"Tecnologia Patenteada","patented_technology_description":"Proteção intelectual no Brasil, EUA e China, criando uma forte barreira de entrada e garantindo nossa exclusividade no mercado.","high_growth_market_title":"Mercado de Alto Crescimento","high_growth_market_description":"Atuação em um setor com demanda reprimida e um déficit habitacional de mais de 6 milhões de unidades no Brasil.","scalable_business_title":"Modelo de Negócio Escalável","scalable_business_description":"Expansão através de licenciamento e parcerias, permitindo um crescimento acelerado com menor necessidade de capital intensivo.","be_our_partner_title":"Seja nosso parceiro","be_our_partner_description":"Estamos abertos a conversas com investidores e parceiros estratégicos que desejam fazer parte da revolução da construção civil.","contact_button":"Entre em Contato","sao_paulo_skyline_alt":"Skyline de São Paulo com a Ponte Estaiada"},"live_cameras":{"title":"Câmeras ao Vivo","watch_operations_title":"Acompanhe Nossas Operações","watch_operations_description":"Veja em tempo real a eficiência e a precisão do nosso sistema construtivo em ação. (Imagens ilustrativas)","production_line_location":"Linha de Produção","panel_assembly_location":"Montagem de Painel","construction_site_location":"Canteiro de Obras","factory_yard_location":"Pátio da Fábrica","live_indicator":"LIVE","production_line_alt":"Câmera CAM-01 - Linha de Produção","panel_assembly_alt":"Câmera CAM-02 - Montagem de Painel","construction_site_alt":"Câmera CAM-03 - Canteiro de Obras","factory_yard_alt":"Câmera CAM-04 - Pátio da Fábrica"}}}],["$","$L5",null,{}],"$Lc"]
